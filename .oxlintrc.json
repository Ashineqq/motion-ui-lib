{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["react", "typescript", "jsx_a11y"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx_a11y/label-has-associated-control": "off"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist/**", "storybook-static/**", "node_modules/**"]
}
